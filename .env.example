# AI Grama Sahayak — Environment Variables Template
# Copy this file to .env and set your local credentials. Do NOT commit .env to Git.

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Application Secret Key (Must be changed in production, min 32 characters)
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_DEV_INSECURE_KEY

# PostgreSQL Database Configuration
# Option 1: Full Connection URL
DATABASE_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@localhost:5432/grama_sahayak_db

# Option 2: Individual connection parameters (used if DATABASE_URL is not set)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=grama_sahayak_db
